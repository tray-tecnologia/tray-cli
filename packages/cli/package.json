{
  "name": "@tray-tecnologia/cli",
  "version": "2.0.0",
  "type": "module",
  "description": "CLI designed to help developers create great themes for Tray E-commerce.",
  "license": "GPL-3.0-only",
  "author": "Tray Plataforma de E-commerce",
  "keywords": [
    "opencode",
    "tray",
    "cli"
  ],
  "scripts": {
    "dev": "vite-node src/dev.ts",
    "lint": "eslint --cache",
    "type:check": "tsc --build --force",
    "build": "vite build",
    "postbuild": "chmod +x dist/bin/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.6.0",
    "axios-retry": "^4.5.0",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "glob": "^11.0.3",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "slash": "^5.1.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/glob": "^7.2.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.2",
    "vite-node": "^3.2.4",
    "vite-plugin-dts": "^4.5.4"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tray": "dist/bin/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "imports": {
    "#cli/*": [
      "./src/*"
    ]
  }
}
