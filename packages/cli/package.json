{
  "name": "@tray-tecnologia/cli",
  "version": "2.0.1",
  "type": "module",
  "description": "CLI designed to help developers create great themes for Tray E-commerce.",
  "license": "GPL-3.0-only",
  "author": "Tray Plataforma de E-commerce",
  "keywords": [
    "opencode",
    "studio",
    "tray",
    "cli"
  ],
  "scripts": {
    "dev": "vite-node src/dev.ts",
    "lint": "eslint --cache",
    "type:check": "tsc --build --force",
    "build": "vite build",
    "watch": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.6.0",
    "@tray-tecnologia/theme-sdk": "*",
    "axios-retry": "^4.5.0",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "glob": "^11.0.3",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "p-limit": "^4.0.0",
    "slash": "^5.1.0"
  },
  "devDependencies": {
    "@tray-tecnologia/config-eslint": "*",
    "@tsconfig/node22": "^22.0.0",
    "@types/glob": "^7.2.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.2",
    "vite-node": "^3.2.4",
    "vite-plugin-dts": "^4.5.4"
  },
  "imports": {
    "#cli/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "./dist"
  ],
  "bin": {
    "tray": "./dist/bin/cli.js"
  }
}
