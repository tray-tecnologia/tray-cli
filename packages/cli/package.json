  },
  "devDependencies": {
    "@tray-tecnologia/config-eslint": "*",
    "@tsconfig/node22": "^22.0.0",
    "@types/glob": "^7.2.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
