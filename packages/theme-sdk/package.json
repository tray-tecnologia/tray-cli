{
  "name": "@tray-tecnologia/theme-sdk",
  "version": "2.0.4",
  "type": "module",
  "description": "Theme SDK to interact with Studio API",
  "license": "GPL-3.0-only",
  "author": "Tray Plataforma de E-commerce",
  "keywords": [
    "opencode",
    "studio",
    "tray",
    "sdk"
  ],
  "scripts": {
    "dev": "vite-node src/dev.ts",
    "lint": "eslint --cache",
    "type:check": "tsc --build --force",
    "build": "vite build",
    "prepublishOnly": "node ../../scripts/check-versions.js && npm run build"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "axios-retry": "^4.5.0",
    "file-type": "^21.3.2"
  },
  "devDependencies": {
    "@tray-tecnologia/config-eslint": "1.0.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/lodash.camelcase": "^4.3.9",
    "@types/node": "^22.15.29",
    "eslint": "^10.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.0.1"
  },
  "imports": {
    "#theme-sdk/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "./dist"
  ]
}
