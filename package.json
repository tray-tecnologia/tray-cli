{
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "turbo run lint",
    "type:check": "turbo run type:check",
    "build": "turbo run build",
    "refresh": "rm -rf ./node_modules ./packages/config-eslint/node_modules ./packages/sdk/node_modules ./packages/cli/node_modules && npm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.2.0",
  "workspaces": [
    "packages/*"
  ]
}
