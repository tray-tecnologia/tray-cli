{
  "name": "cli",
  "license": "GPL-3.0-only",
  "scripts": {
    "lint": "turbo run lint",
    "type:check": "turbo run type:check",
    "build": "turbo run build",
    "refresh": "rm -rf ./node_modules ./packages/config-eslint/node_modules ./packages/sdk/node_modules ./packages/cli/node_modules && npm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.2.0",
  "workspaces": [
    "packages/*"
  ]
}
